# Database (Vercel Postgres / Neon)
POSTGRES_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:pass@host:5432/dbname?sslmode=require

# Duffel API
DUFFEL_API_TOKEN=duffel_test_xxx

# Auth (iron-session)
SESSION_SECRET=at-least-32-characters-long-random-string

# Seed script
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=your-password
